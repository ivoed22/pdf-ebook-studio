{
  "title": "PDF Ebook Studio Project Schema",
  "type": "object",
  "required": [
    "projectMeta",
    "languageVersions",
    "assets",
    "pages"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2],
      "description": "Version 1 is accepted and migrated to version 2 on import."
    },
    "projectMeta": {
      "type": "object",
      "required": [
        "title",
        "productType",
        "documentFormat",
        "theme"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "productType": {
          "enum": [
            "recipe-ebook",
            "interior-magazine",
            "exterior-magazine",
            "general-ebook"
          ]
        },
        "documentFormat": {
          "enum": [
            "A4-portrait"
          ]
        },
        "theme": {
          "type": "string"
        },
        "outputProfile": {
          "enum": [
            "standard-pdf",
            "etsy-digital-product"
          ]
        },
        "author": {
          "type": "string"
        },
        "year": {
          "type": "string"
        },
        "listing": {
          "type": "object",
          "description": "Optional per-language Etsy listing overrides for title, description, tags, contents, customerReadme and thumbnailOrder."
        }
      }
    },
    "languageVersions": {
      "type": "array",
      "items": {
        "enum": [
          "nl",
          "en"
        ]
      }
    },
    "assets": {
      "type": "object",
      "properties": {
        "imageFolder": {
          "type": "string"
        },
        "coverImage": {
          "type": "string"
        }
      }
    },
    "palettes": {
      "type": "array"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "translationKey": { "type": "string" },
          "contentRevision": { "type": "integer", "minimum": 0 },
          "translationSourceRevision": { "type": "integer", "minimum": 0 },
          "chapter": { "type": "string" }
        }
      }
    },
    "production": {
      "type": "object",
      "properties": {
        "qcStatus": { "enum": ["needs-images", "pass"] },
        "images": { "type": "array" },
        "batches": { "type": "array" },
        "sourceMarkdown": { "type": "string" }
      }
    },
    "organization": {
      "type": "object",
      "properties": {
        "folder": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "favorite": { "type": "boolean" },
        "archived": { "type": "boolean" }
      }
    }
  }
}
